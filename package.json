{
  "name": "mobius-3d",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "fixtures": "node verification/make-heavy-fixtures.mjs",
    "check": "npm run build && node verification/check.mjs",
    "check:desktop": "node verification/desktop-check.mjs",
    "site": "npm run build && node tools/site.mjs",
    "dist": "npm run build && node desktop/prepare.cjs && electron-builder --config desktop/builder.cjs --publish never",
    "release": "npm run build && node desktop/prepare.cjs && electron-builder --config desktop/builder.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.10",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "three": "0.180.0"
  },
  "main": "desktop/main.cjs",
  "description": "Mobius 3D — a local 3D model viewer for the desktop and the web",
  "author": "Dex Cimino",
  "license": "UNLICENSED",
  "homepage": "https://github.com/dexdcimino/mobius-3d",
  "repository": {
    "type": "git",
    "url": "https://github.com/dexdcimino/mobius-3d.git"
  }
}
